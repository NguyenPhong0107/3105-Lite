import SwiftUI

struct FileBrowserView: View {
    let folderURL: URL
    let title: String
    
    @State private var viewModel: BrowserViewModel
    
    // States cho các Alert nhập text
    @State private var showingNewFolderAlert = false
    @State private var newFolderName = ""
    
    @State private var showingRenameAlert = false
    @State private var itemToRename: FileItem?
    @State private var newName = ""
    
    init(folderURL: URL, title: String, fileAccessService: FileAccessService) {
        self.folderURL = folderURL
        self.title = title
        _viewModel = State(initialValue: BrowserViewModel(fileAccessService: fileAccessService))
    }
    
    var body: some View {
        List {
            if viewModel.isLoading {
                ProgressView("Loading...")
                    .frame(maxWidth: .infinity, alignment: .center)
            } else if viewModel.files.isEmpty {
                Text("Folder is empty")
                    .foregroundColor(.secondary)
                    .frame(maxWidth: .infinity, alignment: .center)
            } else {
                ForEach(viewModel.files) { file in
                    NavigationLink {
                        if file.isDirectory {
                            // Drill-down: Duyệt vào thư mục con
                            FileBrowserView(
                                folderURL: file.url,
                                title: file.name,
                                fileAccessService: _viewModel.wrappedValue.fileAccessService
                            )
                        } else {
                            // Mở File Editor để chỉnh sửa file text
                            FileEditorView(
                                fileURL: file.url,
                                parentURL: folderURL,
                                fileAccessService: _viewModel.wrappedValue.fileAccessService
                            )
                        }
                    } label: {
                        fileRow(for: file)
                    }
                    // Context Menu (Nhấn giữ) - Tích hợp Zip/Unzip, Rename, Delete
                    .contextMenu {
                        // Tùy chọn Nén / Giải nén (Phase 10)
                        if file.url.pathExtension.lowercased() == "zip" {
                            Button(action: {
                                Task {
                                    do {
                                        _ = try await ZipService().unzipItem(at: file.url)
                                        viewModel.loadFiles(from: folderURL)
                                    } catch {
                                        // Xử lý lỗi nếu cần
                                    }
                                }
                            }) {
                                Label("Giải nén (Unzip)", systemImage: "doc.zipper")
                            }
                        } else {
                            Button(action: {
                                Task {
                                    do {
                                        _ = try await ZipService().zipItem(at: file.url)
                                        viewModel.loadFiles(from: folderURL)
                                    } catch {
                                        // Xử lý lỗi nếu cần
                                    }
                                }
                            }) {
                                Label("Nén thành .zip", systemImage: "archivebox")
                            }
                        }
                        
                        Divider()
                        
                        Button(action: {
                            itemToRename = file
                            newName = file.name
                            showingRenameAlert = true
                        }) {
                            Label("Rename", systemImage: "pencil")
                        }
                        
                        Button(role: .destructive, action: {
                            viewModel.delete(file: file, in: folderURL)
                        }) {
                            Label("Delete", systemImage: "trash")
                        }
                    }
                    // Swipe to Delete (Vuốt sang trái)
                    .swipeActions(edge: .trailing, allowsFullSwipe: true) {
                        Button(role: .destructive) {
                            viewModel.delete(file: file, in: folderURL)
                        } label: {
                            Label("Delete", systemImage: "trash")
                        }
                    }
                }
            }
        }
        .navigationTitle(title)
        .toolbar {
            ToolbarItem(placement: .navigationBarTrailing) {
                Button(action: {
                    newFolderName = ""
                    showingNewFolderAlert = true
                }) {
                    Image(systemName: "folder.badge.plus")
                }
            }
        }
        .onAppear {
            viewModel.loadFiles(from: folderURL)
        }
        // Alert Lỗi
        .alert(
            "Lỗi",
            isPresented: Binding(
                get: { viewModel.errorMessage != nil },
                set: { if !$0 { viewModel.errorMessage = nil } }
            )
        ) {
            Button("OK", role: .cancel) {}
        } message: {
            Text(viewModel.errorMessage ?? "")
        }
        // Alert Tạo thư mục
        .alert("Tạo thư mục mới", isPresented: $showingNewFolderAlert) {
            TextField("Tên thư mục", text: $newFolderName)
            Button("Hủy", role: .cancel) { }
            Button("Tạo") {
                viewModel.createFolder(in: folderURL, name: newFolderName)
            }
        }
        // Alert Đổi tên
        .alert("Đổi tên", isPresented: $showingRenameAlert) {
            TextField("Tên mới", text: $newName)
            Button("Hủy", role: .cancel) { }
            Button("Lưu") {
                if let file = itemToRename {
                    viewModel.rename(file: file, newName: newName, in: folderURL)
                }
            }
        }
    }
    
    // Tách Row ra thành View builder cho gọn
    @ViewBuilder
    private func fileRow(for file: FileItem) -> some View {
        HStack {
            Image(systemName: file.isDirectory ? "folder.fill" : "doc.fill")
                .foregroundColor(file.isDirectory ? .blue : .gray)
                .font(.title2)
                .frame(width: 40)
            
            VStack(alignment: .leading, spacing: 4) {
                Text(file.name)
                    .font(.body)
                    .lineLimit(1)
                
                if !file.isDirectory {
                    Text(formatBytes(file.size))
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
        }
        .padding(.vertical, 4)
    }
    
    private func formatBytes(_ bytes: Int64) -> String {
        let formatter = ByteCountFormatter()
        formatter.allowedUnits = [.useAll]
        formatter.countStyle = .file
        return formatter.string(fromByteCount: bytes)
    }
}
