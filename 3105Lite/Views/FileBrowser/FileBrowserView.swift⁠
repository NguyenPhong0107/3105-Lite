import SwiftUI

struct FileBrowserView: View {
    let folderURL: URL
    let title: String
    
    @State private var viewModel: BrowserViewModel
    
    @State private var showingNewFolderAlert = false
    @State private var newFolderName = ""
    
    @State private var showingRenameAlert = false
    @State private var itemToRename: FileItem?
    @State private var newName = ""
    
    init(folderURL: URL, title: String, fileAccessService: FileAccessService) {
        self.folderURL = folderURL
        self.title = title
        _viewModel = State(initialValue: BrowserViewModel(fileAccessService: fileAccessService))
    }
    
    var body: some View {
        List(selection: $viewModel.selectedFileIDs) {
            if viewModel.isLoading {
                ProgressView("Đang tải...")
                    .frame(maxWidth: .infinity, alignment: .center)
            } else if viewModel.filteredAndSortedFiles.isEmpty {
                ContentUnavailableView(
                    viewModel.searchText.isEmpty ? "Thư mục trống" : "Không tìm thấy kết quả",
                    systemImage: viewModel.searchText.isEmpty ? "folder" : "magnifyingglass",
                    description: Text(viewModel.searchText.isEmpty ? "" : "Thử tìm kiếm với từ khóa khác.")
                )
            } else {
                ForEach(viewModel.filteredAndSortedFiles) { file in
                    NavigationLink {
                        if file.isDirectory {
                            FileBrowserView(
                                folderURL: file.url,
                                title: file.name,
                                fileAccessService: _viewModel.wrappedValue.fileAccessService
                            )
                        } else {
                            let ext = file.url.pathExtension.lowercased()
                            let textExtensions = ["txt", "json", "swift", "xml", "csv", "md", "yml"]
                            
                            if textExtensions.contains(ext) {
                                FileEditorView(
                                    fileURL: file.url,
                                    parentURL: folderURL,
                                    fileAccessService: _viewModel.wrappedValue.fileAccessService
                                )
                            } else {
                                QuickLookPreview(fileURL: file.url)
                                    .navigationTitle(file.name)
                                    .navigationBarTitleDisplayMode(.inline)
                            }
                        }
                    } label: {
                        fileRow(for: file)
                    }
                    .contextMenu {
                        if file.url.pathExtension.lowercased() == "zip" {
                            Button(action: {
                                Task {
                                    _ = try? await ZipService().unzipItem(at: file.url)
                                    viewModel.loadFiles(from: folderURL)
                                }
                            }) {
                                Label("Giải nén (Unzip)", systemImage: "doc.zipper")
                            }
                        } else {
                            Button(action: {
                                Task {
                                    _ = try? await ZipService().zipItem(at: file.url)
                                    viewModel.loadFiles(from: folderURL)
                                }
                            }) {
                                Label("Nén thành .zip", systemImage: "archivebox")
                            }
                        }
                        
                        Divider()
                        
                        Button(action: {
                            itemToRename = file
                            newName = file.name
                            showingRenameAlert = true
                        }) {
                            Label("Đổi tên", systemImage: "pencil")
                        }
                        
                        Button(role: .destructive, action: {
                            viewModel.delete(file: file, in: folderURL)
                        }) {
                            Label("Xóa", systemImage: "trash")
                        }
                    }
                    .swipeActions(edge: .trailing, allowsFullSwipe: true) {
                        Button(role: .destructive) {
                            viewModel.delete(file: file, in: folderURL)
                        } label: {
                            Label("Xóa", systemImage: "trash")
                        }
                    }
                }
            }
        }
        .navigationTitle(title)
        .searchable(text: $viewModel.searchText, prompt: "Tìm kiếm tệp tin...")
        .toolbar {
            ToolbarItemGroup(placement: .navigationBarTrailing) {
                // Nút Bật/Tắt chế độ Chọn hàng loạt
                EditButton()
                
                Menu {
                    Picker("Sắp xếp theo", selection: $viewModel.sortOption) {
                        ForEach(SortOption.allCases) { option in
                            Text(option.rawValue).tag(option)
                        }
                    }
                    
                    Divider()
                    
                    Button(action: {
                        viewModel.sortAscending.toggle()
                    }) {
                        Label(
                            viewModel.sortAscending ? "Thứ tự: Tăng dần" : "Thứ tự: Giảm dần",
                            systemImage: viewModel.sortAscending ? "arrow.up" : "arrow.down"
                        )
                    }
                } label: {
                    Image(systemName: "arrow.up.arrow.down")
                }
                
                Button(action: {
                    newFolderName = ""
                    showingNewFolderAlert = true
                }) {
                    Image(systemName: "folder.badge.plus")
                }
            }
            
            // Thanh công cụ thao tác hàng loạt bên dưới màn hình khi ở chế độ Edit
            ToolbarItemGroup(placement: .bottomBar) {
                if !viewModel.selectedFileIDs.isEmpty {
                    Text("Đã chọn \(viewModel.selectedFileIDs.count) mục")
                        .font(.caption)
                        .foregroundColor(.secondary)
                    
                    Spacer()
                    
                    Button(role: .destructive, action: {
                        viewModel.deleteSelectedFiles(in: folderURL)
                    }) {
                        Label("Xóa chọn", systemImage: "trash")
                    }
                }
            }
        }
        .onAppear {
            viewModel.loadFiles(from: folderURL)
        }
        .alert(
            "Lỗi",
            isPresented: Binding(
                get: { viewModel.errorMessage != nil },
                set: { if !$0 { viewModel.errorMessage = nil } }
            )
        ) {
            Button("OK", role: .cancel) {}
        } message: {
            Text(viewModel.errorMessage ?? "")
        }
        .alert("Tạo thư mục mới", isPresented: $showingNewFolderAlert) {
            TextField("Tên thư mục", text: $newFolderName)
            Button("Hủy", role: .cancel) { }
            Button("Tạo") {
                viewModel.createFolder(in: folderURL, name: newFolderName)
            }
        }
        .alert("Đổi tên", isPresented: $showingRenameAlert) {
            TextField("Tên mới", text: $newName)
            Button("Hủy", role: .cancel) { }
            Button("Lưu") {
                if let file = itemToRename {
                    viewModel.rename(file: file, newName: newName, in: folderURL)
                }
            }
        }
    }
    
    @ViewBuilder
    private func fileRow(for file: FileItem) -> some View {
        HStack {
            Image(systemName: file.isDirectory ? "folder.fill" : "doc.fill")
                .foregroundColor(file.isDirectory ? .blue : .gray)
                .font(.title2)
                .frame(width: 40)
            
            VStack(alignment: .leading, spacing: 4) {
                Text(file.name)
                    .font(.body)
                    .lineLimit(1)
                
                if !file.isDirectory {
                    Text(formatBytes(file.size))
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
        }
        .padding(.vertical, 4)
    }
    
    private func formatBytes(_ bytes: Int64) -> String {
        let formatter = ByteCountFormatter()
        formatter.allowedUnits = [.useAll]
        formatter.countStyle = .file
        return formatter.string(fromByteCount: bytes)
    }
}
